#!/usr/bin/env python3
"""Print what docker-bake.hcl will build: each target, its Dockerfile, the targets
it starts from and where its output goes. Reads `docker buildx bake --print`.

    scripts/bake-graph [bake targets...]        # default: all
"""

import json
import subprocess
import sys

targets = sys.argv[1:] or ["all"]
printed = json.loads(subprocess.run(["docker", "buildx", "bake", "--print", *targets],
                                    capture_output=True, text=True, check=True).stdout)
for name, t in sorted(printed["target"].items()):
    inputs = sorted(v.removeprefix("target:") for v in (t.get("contexts") or {}).values())
    outputs = [o.get("dest") or o.get("type") for o in t.get("output") or []]
    print(f"{name:14} {t.get('dockerfile', '-'):28} from: {', '.join(inputs) or '-':45} -> {', '.join(outputs)}")
