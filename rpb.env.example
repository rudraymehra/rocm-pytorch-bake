# Site values for docker buildx bake, as environment variables. Copy to rpb.env
# (gitignored) on the host that runs bake, edit, then load it into the shell:
#
#   set -a; . ./rpb.env; set +a
#
# bake reads a variable from the environment when its name matches, and keeps the
# type and validation from docker-bake.hcl. --var on the command line still wins.

CACHE_REGISTRY=zot.lan:5000                       # the same host:port as ZOT_ADDR on the builders
SCCACHE_ENV_FILE=/abs/path/to/secrets/sccache.env # written by infra/cache-node/make-secrets.sh
MAX_JOBS=32                                       # min(cores, RAM GiB / 2.5); one value per host class (cache key)
FANOUT_JOBS=8                                     # about MAX_JOBS / 4
